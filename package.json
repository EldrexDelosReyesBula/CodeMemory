    "chalk": "^5.4.1",
    "chokidar": "^4.0.3",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "ignore": "^7.0.3",
    "ora": "^8.2.0",
    "zod": "^3.24.2"
