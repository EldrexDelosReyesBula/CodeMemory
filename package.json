  "description": "The Persistent Intelligence Layer for Codebases - Local-first CLI & MCP server for AI agents",
  "type": "module",
  "bin": {
    "codememory": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "website",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EldrexDelosReyesBula/CodeMemory.git"
  },
  "homepage": "https://codemem.vercel.app",
